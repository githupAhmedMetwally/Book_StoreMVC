@using StaticClasses
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.PageTitle - BookStore</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            background-color: #f8f9fa;
        }

        .navbar-custom {
            background-color: #17a2b8;
        }

            .navbar-custom .navbar-brand,
            .navbar-custom .nav-link {
                color: white;
            }

        .book-card {
            border: 1px solid #ddd;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
        }

            .book-card:hover {
                transform: translateY(-10px);
            }

        .book-img {
            width: 100%;
            height: 250px;
            object-fit: cover;
        }

        .book-info {
            padding: 15px;
        }

        footer {
            background-color: #e9ecef;
            padding: 10px 0;
            text-align: center;
        }
    </style>
</head>

<body>
    <!-- Header/Navbar -->
    <header class="navbar navbar-expand-lg navbar-custom px-4 d-flex justify-content-between align-items-center">
        <!-- Left: Logo -->
        <a class="navbar-brand fw-bold" href="/">📚 BookStore</a>

        <!-- Center/Right: Links -->
        <ul class="navbar-nav flex-row">
            @if (User.Identity.IsAuthenticated)
            {
                @if (User.IsInRole(SD.AdminRole))
                {
                    <li class="nav-item mx-2">
                        <a class="nav-link active text-white" href="/Admin/Category/Index">Dashboard</a>
                    </li>
                }
                else
                {
                    <li class="nav-item mx-2">
                        <a class="nav-link active text-white" href="/Customer/Borrow/Index">
                            📖 My Borrowed Books
                        </a>
                    </li>
                    <li class="nav-item dropdown mx-2">
                        <a class="nav-link dropdown-toggle text-white" id="navbarDropdown" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            My Settings
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" href="/Identity/Account/Manage">Edit Profile</a></li>
                        </ul>
                    </li>
                }
            }
        </ul>

        <!-- Login Partial + Hamburger Button -->
        <div class="d-flex align-items-center">
            <partial name="_LoginPartial" />
            <button class="navbar-toggler ms-3" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarNav" aria-controls="navbarNav"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container my-5">
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
