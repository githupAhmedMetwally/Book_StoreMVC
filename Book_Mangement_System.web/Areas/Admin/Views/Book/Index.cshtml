@using Models.Models
@model IEnumerable<Book>

@{
    ViewBag.PageTitle = "Book Management";
    ViewBag.CardTitle = "All Books";
    
   

}

<div class="d-flex justify-content-between align-items-center mb-3">
   
    <a class="btn btn-primary" href="/Admin/Book/Create">Create</a>
</div>

<table class="table table-bordered table-hover table-striped text-center">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Pages</th>
            <th>Author</th>
            <th>Category</th>
            <th>Publisher</th>
            <th>Publish Date</th>
            <th>Number of Copies</th>
            <th>ISBN</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Pages</td>
                <td>@item.Author?.Name</td>
                <td>@item.Category?.Name</td>
                <td>@item.Publisher?.Name</td>
                <td>@item.PublishDate.ToString("yyyy-MM-dd")</td>
                <td>@item.NumberOfCopies</td>
                <td>@item.ISBN</td>
                <td>
                    <a class="btn btn-sm btn-success me-1" href="/Admin/Book/Edit/@item.Id">Edit</a>
                    <a class="btn btn-sm btn-danger" href="/Admin/Book/Delete/@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
