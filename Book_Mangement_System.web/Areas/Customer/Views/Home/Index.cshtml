@using Models.Models
@model IEnumerable<Book>



    <h3 class="text-center text-primary mb-4">Our Books Collection</h3>
  

    <div class="row">
    @foreach (var book in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm hover-shadow">
                <a href="Customer/Home/Details/@book.Id"><img src="~/@book.Img" alt="@book.Title" class="card-img-top img-fluid" style="height: 300px; object-fit: cover;" /></a>
                <div class="card-body d-flex flex-column justify-content-between">
                    <h5 class="card-title text-center">@book.Title</h5> <!-- التايتل في النص -->
                    <p class="card-text"><strong>Author:</strong> @book.Author.Name</p> <!-- الاوثر زي ماهو -->
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="Customer/Home/Details/@book.Id" class="btn btn-primary w-100">View Details</a>
                </div>
            </div>
        </div>
    }
</div>

<style>
    
    .card:hover {
        transform: scale(1.05);
        transition: transform 0.3s ease-in-out;
    }

    .hover-shadow:hover {
        box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.1);
    }
</style>
