@using Models.Models
@model Category

@{
    ViewBag.PageTitle = "Category Management";
    ViewBag.CardTitle = "Create Category";
}

<div class="card shadow rounded p-4 col-md-6 mx-auto mt-4">
    <h3 class="mb-4 text-center">@ViewBag.CardTitle</h3>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-floating mb-3">
            <input asp-for="Name" class="form-control" placeholder="Category Name" />
            <label asp-for="Name"></label>
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Description" class="form-control" placeholder="Description" />
            <label asp-for="Description"></label>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            <button type="submit" class="btn btn-primary">Create</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
